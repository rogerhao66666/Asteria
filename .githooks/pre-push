#!/usr/bin/env bash
# Before a push to main: the whole test suite on a clean Linux machine (Docker, Python 3.13)
# for exactly the commit being pushed - what GitHub's CI would run, without its minutes.
# Other sessions' uncommitted work in this folder is not part of it. About five minutes.
# Docker must be running. `git push --no-verify` skips it (only when the user says so).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
tested=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "${remote_ref}" == "refs/heads/main" && "${local_sha}" != "${zero}" ]] || continue
    [[ "${tested}" == *"${local_sha}"* ]] && continue
    if ! docker info >/dev/null 2>&1; then
        echo "pre-push: Docker is not running - start Docker Desktop, then push again." >&2
        exit 1
    fi
    echo "pre-push: testing ${local_sha:0:8} in Docker (Python 3.13) before the push..." >&2
    if ! scripts/docker_tests.sh --commit "${local_sha}" 3.13 >&2; then
        echo "pre-push: the tests failed in Docker - the push was stopped." >&2
        exit 1
    fi
    tested="${tested} ${local_sha}"
done
